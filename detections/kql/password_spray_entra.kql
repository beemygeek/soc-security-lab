// Password spraying against Entra ID: one IP failing for many users with
// "invalid password" while success rate stays near zero.
// Table: SigninLogs | ATT&CK: T1110.003
// 50126 = invalid username or password; 50053 = smart lockout
SigninLogs
| where TimeGenerated > ago(1d)
| where ResultType in ("50126", "50053", "0")
| summarize
    Failures      = countif(ResultType != "0"),
    Successes     = countif(ResultType == "0"),
    DistinctUsers = dcountif(UserPrincipalName, ResultType != "0"),
    SampleUsers   = make_set_if(UserPrincipalName, ResultType != "0", 15),
    Apps          = make_set(AppDisplayName, 5)
    by IPAddress, bin(TimeGenerated, 1h)
| where DistinctUsers >= 10
| extend SuccessRate = round(100.0 * Successes / (Failures + Successes), 1)
| extend Note = iff(Successes > 0, "Check succeeded accounts for compromise", "")
| order by DistinctUsers desc
